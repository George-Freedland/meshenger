[Unit]
Description=Meshenger mesh gateway (Bluetooth relay)
After=bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/REPLACE_ME/meshenger
ExecStart=/home/REPLACE_ME/meshenger/meshenger-relay --name "Pi Gateway"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
